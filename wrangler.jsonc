{
  "name": "mise",
  "main": "src/index.js",
  "routes": [{ "pattern": "mise.llll-ll.com", "custom_domain": true }],
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/*", "!/*.js", "!/*.css", "!/*.svg", "!/*.png", "!/*.jpg", "!/*.jpeg", "!/*.gif", "!/*.webp", "!/*.ico", "!/*.txt", "!/*.geojson", "!/*.json", "!/*.woff", "!/*.woff2"] },
  "d1_databases": [{ "binding": "DB", "database_name": "mise", "database_id": "ebcd8092-5f2e-4119-9e15-692c1aae631a", "migrations_dir": "migrations" }],
  // ブランチのプレビュー(wrangler preview)は本番DBでなくプレビュー専用DBを使う（docs/operations/deploy.md）
  "previews": { "d1_databases": [{ "binding": "DB", "database_id": "d55d6451-d683-40ae-bf85-2a03422af006" }] }
}
